  "configurationTemplates": [
    { "templatePath": "pbbridge-project.example.json", "targetPath": ".pbbridge/project.json", "scope": "repo" },
    { "templatePath": "pbbridge-workspace.example.json", "targetPath": ".pbbridge/workspaces/<workspace-id>/workspace.json", "scope": "workspace" },
    { "templatePath": "runtime-dependencies.example.json", "targetPath": ".pbbridge/runtime-dependencies.json", "scope": "repo", "installMode": "copy-if-explicitly-reviewed" },
    { "templatePath": "migration-policy.example.json", "targetPath": ".pbbridge/migration-policy.json", "scope": "repo-policy", "installMode": "copy-if-explicitly-reviewed", "upgradeClassification": "project-migration-policy" }
  ],
